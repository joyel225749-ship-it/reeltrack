# Port the Express server listens on (default: 5000)
PORT=5000

# MongoDB Atlas connection string — replace with your own cluster URI.
# Never commit the real value; keep it in backend/.env only.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/movie_watchlist?retryWrites=true&w=majority

# The URL of your frontend — used for the CORS allow-list.
# For local dev this is the Vite dev server address.
# Update to your deployed Render/Netlify/Vercel URL for production.
CLIENT_ORIGIN=http://localhost:5173
